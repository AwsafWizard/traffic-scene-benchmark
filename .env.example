# Copy to .env.local for local development. On Vercel, set the same names in
# Project Settings -> Environment Variables. Never commit real values.

# Postgres connection. Locally: run `npm run db:dev` and use the value below.
# On Vercel: Supabase -> Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543), with your database password filled in.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/dhakavqa

# The one admin account, created on the first deploy. Changing these later does
# nothing unless you run `npm run db:migrate -- --reset-admin`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cloudinary -> Settings -> API Keys. Required in production; leave empty locally
# to keep images on disk in .uploads/ instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: lets the admin run the 10% model check by API instead of pasting answers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
