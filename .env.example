# Copy to .env.local for local development. On Vercel, set the same names in
# Project Settings -> Environment Variables. Never commit real values.

# Postgres connection. Locally: run `npm run db:dev` and use the value below.
# On Vercel: Supabase -> Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543), with your database password filled in.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/dhakavqa

# The one admin account, created on the first deploy. Changing these later does
# nothing unless you run `npm run db:migrate -- --reset-admin`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cloudinary -> Settings -> API Keys. Required in production; leave empty locally
# to keep images on disk in .uploads/ instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Encrypts the provider API keys the admin adds on the Models page (32 random
# bytes, base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes stored keys unreadable; re-enter them.
ENCRYPTION_KEY=

# Reads the video library: a private Hugging Face dataset repo the admin adds
# videos from (Settings -> Videos). huggingface.co -> Settings -> Access Tokens
# -> Fine-grained, with only "Read access to contents of selected repos" for that
# repo. It stays on the server; setters get short-lived links to one video at a
# time. Optional; without it setters can only upload or paste images.
HF_TOKEN=
